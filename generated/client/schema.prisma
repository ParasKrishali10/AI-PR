// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String       @id @default(cuid())
  githubId String       @unique
  name     String?
  repos    Repository[]
  settings Settings[]
}

model Repository {
  id             String        @id @default(cuid())
  githubRepoId   Int           @unique
  fullName       String
  owner          String
  installationId Int
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())
  pullRequests   PullRequest[]
}

model PullRequest {
  id            String            @id @default(cuid())
  githubPrId    BigInt            @unique
  prNumber      Int
  title         String
  state         String
  author        String
  additions     Int
  deletions     Int
  changedFiles  Int
  repoId        String
  commentPosted String            @default("")
  repository    Repository        @relation(fields: [repoId], references: [id])
  createdAt     DateTime          @default(now())
  risk          PullRequestRisk[]
}

model PullRequestRisk {
  id                String  @id @default(cuid())
  pullRequestId     String  @unique
  commentPosted     Boolean @default(false)
  hasDependencyRisk Boolean
  hasAuthRisk       Boolean
  hasMalciousRisk   Boolean
  comment           String  @default("")

  malciousReasons String[]
  affectedFiles   String[]

  createdAt DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id])
}

model Settings {
  id                   String   @id @default(cuid())
  enableDependencyRisk Boolean  @default(true)
  enableAuthRisk       Boolean  @default(true)
  enableMaliciousRisk  Boolean  @default(true)
  riskLevel            String   @default("medium")
  ignoredPaths         String[]
  allowedExtensions    String[]
  enableEval           Boolean  @default(false)
  enableExec           Boolean  @default(false)
  enableChildProcess   Boolean  @default(false)
  enableExternalFetch  Boolean  @default(false)
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [githubId])
  commentStyle         String   @default("detailed")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model WebhookEvent {
  id         Int      @id @default(autoincrement())
  deliveryId String   @unique
  createdAt  DateTime @default(now())
}
